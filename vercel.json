{
  "version": 2,
  "name": "dynapharm-cloud",
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "dynapharm-complete-system.html", "use": "@vercel/static" },
    { "src": "appointments-admin.html", "use": "@vercel/static" },
    { "src": "distributor-guest.html", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "api/health.js", "use": "@vercel/node" },
    { "src": "api/clients.js", "use": "@vercel/node" },
    { "src": "api/users.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/", "dest": "/dynapharm-complete-system.html" },
    { "src": "/dynapharm-complete-system", "dest": "/dynapharm-complete-system.html" },
    { "src": "/distributor/guest", "dest": "/distributor-guest.html" },
    { "src": "/staff/appointments", "dest": "/appointments-admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS, HEAD" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}


