{
  "version": 2,
  "name": "dynapharm-namibia-health",
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "frontend/*.html", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "cloud-sync.js", "use": "@vercel/static" },
    { "src": "cloud-data/*", "use": "@vercel/static" },
    { "src": "reports_data.json", "use": "@vercel/static" },
    { "src": "web-modules/*.js", "use": "@vercel/static" },
    { "src": "assets/*", "use": "@vercel/static" },
    { "src": "api/health.js", "use": "@vercel/node" },
    { "src": "api/clients.js", "use": "@vercel/node" },
    { "src": "api/users.js", "use": "@vercel/node" },
    { "src": "api/orders.js", "use": "@vercel/node" },
    { "src": "api/branches.js", "use": "@vercel/node" },
    { "src": "api/notifications.js", "use": "@vercel/node" },
    { "src": "api/reports.js", "use": "@vercel/node" },
    { "src": "api/attendance.js", "use": "@vercel/node" },
    { "src": "api/leave.js", "use": "@vercel/node" },
    { "src": "api/employees.js", "use": "@vercel/node" },
    { "src": "api/stock-movements.js", "use": "@vercel/node" }
  ],
  "functions": {
    "api/*.js": {
      "runtime": "nodejs18.x",
      "memory": 256,
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" }
  ],
  "redirects": [
    { "source": "/", "destination": "/dynapharm-complete-system.html", "permanent": false },
    { "source": "/dynapharm-complete-system", "destination": "/dynapharm-complete-system.html", "permanent": false },
    { "source": "/distributor/guest", "destination": "/distributor-guest.html", "permanent": false },
    { "source": "/staff/appointments", "destination": "/appointments-admin.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS, HEAD" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}


